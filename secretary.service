# Copy to /etc/systemd/system/secretary.service and replace YOUR_USER and
# /path/to/secretary with your own values. See "Running as a Linux service"
# in README.md.

[Unit]
Description=Secretary voice assistant
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/secretary
EnvironmentFile=/path/to/secretary/.env
Environment=ENVIRONMENT=production
ExecStart=/path/to/secretary/.venv/bin/fastapi run main.py --port 8000
Restart=on-failure

# Light sandboxing. Drop these if they get in the way of your notes directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
