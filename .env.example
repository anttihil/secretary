AI_CLIENT=local
# Where notes are stored. Point this at an existing markdown folder to use
# notes you already have — see "Using an existing notes folder" in README.md
# NOTES_DIR=./notes
LLM_MODEL_PATH=./models/your-model.gguf
WHISPER_MODEL=base.en
# Whisper device: "cpu", "cuda", "auto" (auto-detect)
# WHISPER_DEVICE=cpu
# Whisper compute type: "auto", "int8", "float16", "float32"
# WHISPER_COMPUTE_TYPE=auto
# Number of LLM layers to offload to GPU (0=CPU only, -1=all layers)
# Logging settings:
# LOG_LEVEL=INFO  # INFO, DEBUG, WARNING, ERROR
# LOG_DIR=./logs  # Directory for rotating log files (default: ./logs)
# LOG_FILE=./logs/secretary.log  # Specific log file path (optional override)
# Logs rotate daily into numbered files (.1, .2, ..., .30) and files older than 30 days are removed.

# AWS only:
# S3_BUCKET=your-bucket
# For microphone access from other machines on tailnet, the browser
# requires HTTPS (localhost works without it). Get certs with:
#   tailscale cert your-machine.tailnet-name.ts.net
# Then run uvicorn with:
#   uv run uvicorn main:app --host 0.0.0.0 --ssl-keyfile=... --ssl-certfile=...

